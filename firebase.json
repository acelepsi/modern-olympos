{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["node scripts/prepare-site.cjs"],
    "headers": [
      { "source": "**/*.@(js|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
    ]
  },
  "firestore": {
    "rules": ".launch/firestore.rules",
    "predeploy": ["node scripts/prepare-launch.cjs --verify"]
  }
}
